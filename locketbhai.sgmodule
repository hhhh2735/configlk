#!name=Locket Vip Module - Bui Hai
#!desc=Module ghép thêm tính năng Locket VIP (Dùng chung với cấu hình khác)
#!author=BuiHai

[Header Rewrite]
# Xóa bộ nhớ đệm ETag của RevenueCat
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del x-revenuecat-etag
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del X-RevenueCat-ETag

[Script]
# 1. File Hack Bản quyền VIP
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/hhhh2735/configlk/refs/heads/main/bhailk.js, requires-body=true, max-size=-1, timeout=60

# 2. File Xóa trí nhớ tạm
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/hhhh2735/configlk/refs/heads/main/deleteHeader.js, timeout=60

# 3. File Thêm tính năng & Khung chữ
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/hhhh2735/configlk/refs/heads/main/bhai.js, requires-body=true, max-size=-1, timeout=60

[MITM]
# Chỉ giải mã dữ liệu của 2 máy chủ Locket
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com